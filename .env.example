# --- Supabase (M1 auth + Postgres) ---
# Public by design: used by browser + server clients.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY: bypasses RLS. Never NEXT_PUBLIC_*, never in git, never client-imported
# (only lib/db/admin.ts and one-off scripts under scripts/ may reference it).
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY: postgres connection used by Drizzle + the migration script.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Gemini OCR (existing, server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash-lite
SAMPLE_OCR=0
APP_ORIGIN=                # public origin for recovery links (set in production; forwarded headers are only trusted in dev). PRODUCTION FAIL-CLOSED: boot without it refuses the recovery flow.
# --- M3 super admin panel (server only) ---
# 32-byte random hex: `openssl rand -hex 32`. Signs impersonation cookies
# (imp=<id>.<hmac(id|admin|target|exp)>). PRODUCTION FAIL-CLOSED: without it
# impersonation start refuses and validation never trusts a cookie.
IMP_SECRET=
# Salt for audit ip_hash = sha256(ip + AUDIT_SALT) — raw IPs are never
# stored. Missing salt => audit rows simply carry no ip_hash.
AUDIT_SALT=
TRUST_PROXY=false           # set true ONLY behind a proxy that overwrites x-forwarded-for (per-IP rate-limit attribution)
